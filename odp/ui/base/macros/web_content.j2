                            <button onclick="removeFieldListEntry(this, '{{ field_list.name }}')" type="button"
                                    class="ms-2 btn btn-outline-danger btn-remove-field-list-entry d-flex align-items-center justify-content-center"
                                    style="width: 30px; height:30px; padding: 0;">
                                &#128465;
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <button onclick="appendFieldListEntry('{{ field_list.name }}')" type="button"
                    class="btn btn-outline-info btn-sm mt-1">
                Add
                Another {{ field_list.label.text[:-1] if field_list.label.text.endswith('s') else field_list.label.text }}
            </button>
        </div>
    </div>
{% endmacro %}

{% macro field_row(field, obj=none) %}
    <div class="row align-items-baseline mt-4">
        <div class="col-2 text-end">
            {{ field.label(class='form-label' + (' required' if field.flags.required else ''), style='font-size: 1.3rem;') }}
        </div>
        <div class="col-8">
            {% if field.type == 'FieldList' %}
                <div class="mt-n4"> {{ render_field_list(field) }} </div>
            {% elif field.type == 'FormField' %}
                <div class="mt-n4"> {{ render_subform(field) }} </div>
            {% else %}
                {{ render_field(field, obj, **kwargs) }}
            {% endif %}
        </div>
    </div>
{% endmacro %}